# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── PostgreSQL (Neon / Supabase / Render Postgres) ──────────────────────────
# DATABASE_URL      = Pooler/transaction URL  (used at runtime by the app)
# DIRECT_DATABASE_URL = Direct connection URL (used by prisma migrate deploy)
#
# Supabase example:
#   DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
#   DIRECT_DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
#
# Neon example:
#   DATABASE_URL="postgresql://neondb_owner:[password]@ep-xxx-pooler.neon.tech/neondb?sslmode=require"
#   DIRECT_DATABASE_URL="postgresql://neondb_owner:[password]@ep-xxx.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/dbname?sslmode=require"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/dbname?sslmode=require"

# ─── JWT (Access token — short lived) ─────────────────────────────────────────
JWT_SECRET=your_access_token_secret_min_32_chars
JWT_EXPIRES_IN=15m

# ─── JWT (Refresh token — long lived) ─────────────────────────────────────────
JWT_REFRESH_SECRET=your_refresh_token_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Seed script (used by: npm run seed:admin) ────────────────────────────────
SEED_ADMIN_EMAIL=admin@yourdomain.edu
SEED_ADMIN_PASSWORD=YourSecurePassword123!
SEED_ADMIN_NAME=Super Admin

# ─── Cloudinary (optional — for image uploads) ────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
