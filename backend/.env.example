# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── PostgreSQL (Neon / Supabase / Render Postgres) ──────────────────────────
# Get this from your PostgreSQL provider dashboard
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/cse_department?sslmode=require"

# ─── JWT (Access token — short lived) ─────────────────────────────────────────
JWT_SECRET=your_access_token_secret_min_32_chars
JWT_EXPIRES_IN=15m

# ─── JWT (Refresh token — long lived) ─────────────────────────────────────────
JWT_REFRESH_SECRET=your_refresh_token_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Seed script (used by: npm run seed:admin) ────────────────────────────────
SEED_ADMIN_EMAIL=admin@yourdomain.edu
SEED_ADMIN_PASSWORD=YourSecurePassword123!
SEED_ADMIN_NAME=Super Admin

# ─── Cloudinary (optional — for image uploads) ────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
