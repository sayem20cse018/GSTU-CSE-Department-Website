# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Get this from: cloud.mongodb.com → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/cse_department?retryWrites=true&w=majority

# ─── JWT (Access token — short lived) ─────────────────────────────────────────
JWT_SECRET=your_access_token_secret_min_32_chars
JWT_EXPIRES_IN=15m

# ─── JWT (Refresh token — long lived) ─────────────────────────────────────────
JWT_REFRESH_SECRET=your_refresh_token_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Seed script (used by: npm run seed:admin) ────────────────────────────────
SEED_ADMIN_EMAIL=admin@yourdomain.edu
SEED_ADMIN_PASSWORD=YourSecurePassword123!
SEED_ADMIN_NAME=Super Admin
